# Copy to .env and adjust. All variables use the SUPERTONIC_ prefix.

# Interface to bind. Anything other than loopback requires SUPERTONIC_API_KEY.
SUPERTONIC_HOST=127.0.0.1
# TCP port (1-65535).
SUPERTONIC_PORT=8787
# Bearer token clients must send. Required when exposed beyond loopback or via a public URL.
# Without a key, requests carrying proxy headers (X-Forwarded-For, CF-Connecting-IP, ...)
# are refused with 403. A blank value means no key.
# SUPERTONIC_API_KEY=
# Public URL if served through a tunnel/proxy (also requires an API key). For a quick tunnel
# with a random hostname, any value works.
# SUPERTONIC_PUBLIC_URL=
# Where custom voices and server data are stored (~ is expanded).
# SUPERTONIC_DATA_DIR=~/.supertonic-server
# Directory with local Supertonic model weights (default: download to the Hugging Face cache).
# SUPERTONIC_MODEL_DIR=
# Synthesis worker count; 0 = min(4, max(1, cpu_count // 2)).
SUPERTONIC_WORKERS=0
# ONNX intra-op threads per worker (>= 1); unset = ceil(cpu_count / workers).
# SUPERTONIC_INTRA_OP_THREADS=
# Max waiting synthesis jobs before the server answers 503 (>= 1). Realtime work has its own
# allowance of the same size.
SUPERTONIC_MAX_QUEUE=64
# Denoising steps (1-100) for realtime WebSocket sentences and pcm speech requests without
# total_steps (fewer = lower latency, see docs/benchmarks.md).
SUPERTONIC_REALTIME_STEPS=3
# Voice used when a request names none (realtime WebSocket connections).
SUPERTONIC_DEFAULT_VOICE=F1
# Voice builder service URL (unused until Plan 2).
# SUPERTONIC_BUILDER_URL=

# Settings read by the supertonic-mcp process (set in your MCP client config, not the server):
# SUPERTONIC_BASE_URL=http://127.0.0.1:8787
# SUPERTONIC_MCP_OUTPUT_DIR=./supertonic-output
