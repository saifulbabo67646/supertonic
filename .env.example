# Copy to .env and adjust. All variables use the SUPERTONIC_ prefix.

# Interface to bind. Anything other than loopback requires SUPERTONIC_API_KEY.
SUPERTONIC_HOST=127.0.0.1
# TCP port (1-65535).
SUPERTONIC_PORT=8787
# Bearer token clients must send. Required when exposed beyond loopback or via a public URL.
# Without a key, requests carrying proxy headers (X-Forwarded-For, CF-Connecting-IP, ...)
# are refused with 403. A blank value means no key.
# SUPERTONIC_API_KEY=
# Public URL if served through a tunnel/proxy (also requires an API key). For a quick tunnel
# with a random hostname, any value works.
# SUPERTONIC_PUBLIC_URL=
# Without an API key, requests whose Host is not localhost, 127.0.0.1, [::1] or the bind host
# are refused (403 forbidden_host, against DNS rebinding), and so are browser requests from
# other web sites (an Origin other than this server's own: 403 forbidden_origin). Extra Host
# names and origins to accept, comma-separated. Not used when an API key is set.
# SUPERTONIC_ALLOWED_HOSTS=
# SUPERTONIC_ALLOWED_ORIGINS=http://localhost:3000
# Where custom voices and server data are stored (~ is expanded).
# SUPERTONIC_DATA_DIR=~/.supertonic-server
# Directory with local Supertonic model weights (default: download to ~/.cache/supertonic3).
# SUPERTONIC_MODEL_DIR=
# Synthesis worker count; 0 = min(4, max(1, cpu_count // 2)).
SUPERTONIC_WORKERS=0
# ONNX intra-op threads per worker (>= 1); unset = ceil(cpu_count / workers).
# SUPERTONIC_INTRA_OP_THREADS=
# Max waiting synthesis jobs before the server answers 503 (>= 1). Realtime work has its own
# allowance of the same size.
SUPERTONIC_MAX_QUEUE=64
# Denoising steps (1-100) for realtime WebSocket sentences and pcm speech requests without
# total_steps (fewer = lower latency, see docs/benchmarks.md).
SUPERTONIC_REALTIME_STEPS=3
# Voice used when a request names none (realtime WebSocket connections).
SUPERTONIC_DEFAULT_VOICE=F1
# Voice building from reference audio: off = disabled; otherwise SUPERTONIC_BUILDER_URL, when
# set, forwards builds there; else builds run here if this machine has a CUDA GPU and the
# builder extra (uv sync --extra builder). auto skips building quietly when that is missing,
# local logs an error.
SUPERTONIC_BUILDER=auto
# Another supertonic-server that builds voices for this one (e.g. a Windows GPU machine), on
# a trusted LAN or through an SSH tunnel (ssh -N -L 8788:127.0.0.1:8787 gpu-box, then
# http://127.0.0.1:8788). scripts/setup-builder.ps1 / .sh print these lines. See docs/builder.md.
# SUPERTONIC_BUILDER_URL=http://gpu-box:8787
# That server's API key. A blank value means no key.
# SUPERTONIC_BUILDER_API_KEY=
# Minutes a single voice build may run before it is stopped and marked failed (>= 1).
SUPERTONIC_BUILDER_TIMEOUT_MIN=150
# Debugging: SUPERTONIC_BUILDER_ACCURATE_STEPS caps the accurate method's optimisation steps
# (default 3000). The worker reads it from the process environment only, not from .env.

# Settings read by the supertonic-mcp process (set in your MCP client config, not the server):
# SUPERTONIC_BASE_URL=http://127.0.0.1:8787
# SUPERTONIC_MCP_OUTPUT_DIR=./supertonic-output
